# Copy to .env and fill in real values. Never commit .env.

# Slack incoming webhook URLs (Settings > Incoming Webhooks in your Slack app)
SLACK_WEBHOOK_SALES=https://hooks.slack.com/services/REPLACE/ME
SLACK_WEBHOOK_CS=https://hooks.slack.com/services/REPLACE/ME

# Anthropic API key (get from console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# n8n webhook for the on-demand notify workflow (kindling_notify.json → Webhook node → Production URL).
# The UI's "Send to #…" buttons call POST /notify/slack, which forwards here.
N8N_NOTIFY_WEBHOOK=

# Clay webhook: not wired into n8n (decision 2026-11-23, Clay stays a manual step). Unused.
CLAY_WEBHOOK_URL=
